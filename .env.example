# Copy to .env and fill in real values locally. Never commit .env.
# Once a secrets manager (Doppler/Infisical) is set up, this file becomes documentation only —
# real values get injected by the secrets manager, not read from .env in deployed environments.

# --- Anthropic (see docs/security/anthropic-key-separation.md) ---
# Separate keys per environment, each in its own Anthropic Workspace, each with a spend cap.
ANTHROPIC_API_KEY_DEV=
ANTHROPIC_API_KEY_PROD=

# --- Supabase (project: bro-startit-dev, ref: vyqyzrjgjvvzayserddu, region: us-east-1) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Secrets manager (see docs/security/secrets-manager-setup.md) ---
# DOPPLER_TOKEN= (if using Doppler)
# INFISICAL_TOKEN= (if using Infisical)
